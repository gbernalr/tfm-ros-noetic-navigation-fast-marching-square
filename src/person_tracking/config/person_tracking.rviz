Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Escena1
        - /RGB-D1
        - /Tracking1
      Splitter Ratio: 0.58
    Tree Height: 760
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: /camera/depth/points
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Enabled: true
      Name: Escena
      Displays:
        - Class: rviz/Grid
          Name: Suelo (world)
          Enabled: true
          Alpha: 0.55
          Cell Size: 0.5
          Color: 160; 160; 164
          Plane: XY
          Plane Cell Count: 40
          Reference Frame: world
          Line Style:
            Line Width: 0.03
            Value: Lines
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Name: Ejes world
          Length: 0.75
          Radius: 0.04
          Reference Frame: world
          Value: true
        - Class: rviz/TF
          Enabled: true
          Name: TF
          Frame Timeout: 15
          Marker Scale: 0.5
          Frames:
            All Enabled: true
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Update Interval: 0
          Value: true
    - Class: rviz/Group
      Enabled: true
      Name: RGB-D
      Displays:
        - Class: rviz/PointCloud2
          Enabled: true
          Name: Nube de puntos
          Topic: /camera/depth/points
          Queue Size: 10
          Style: Flat Squares
          Size (Pixels): 3
          Size (m): 0.02
          Color Transformer: RGB8
          Position Transformer: XYZ
          Selectable: true
          Use Fixed Frame: true
          Decay Time: 0
          Invert Rainbow: false
          Use rainbow: false
          Axis: Z
          Channel Name: intensity
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Value: true
            Min Value: -10
            Max Value: 10
          Min Color: 0; 0; 0
          Max Color: 255; 255; 255
          Unreliable: false
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Name: Ejes optical
          Length: 0.25
          Radius: 0.015
          Reference Frame: camera_depth_optical_frame
          Value: true
    - Class: rviz/Group
      Enabled: true
      Name: Tracking
      Displays:
        - Class: rviz/Path
          Enabled: true
          Name: Predicted Path
          Topic: /person_tracking/predicted_path
          Buffer Length: 1
          Color: 255; 90; 50
          Alpha: 1
          Line Style: Lines
          Line Width: 0.08
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.03
          Shaft Length: 0.1
          Shaft Radius: 0.01
          Head Length: 0.03
          Head Radius: 0.02
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Name: Person Markers
          Marker Topic: /person_tracking/markers
          Namespaces:
            detection: true
            prediction: true
            track: true
            velocity: true
          Queue Size: 10
          Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 38
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7.0
      Focal Point:
        X: 2.8
        Y: 0.0
        Z: 0.9
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: world
      Value: Orbit (rviz)
      Yaw: 0.2
      Enable Stereo Rendering:
        Value: false
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: false
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 1680
  X: 60
  Y: 40
