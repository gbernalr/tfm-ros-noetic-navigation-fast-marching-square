Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Escena1
        - /RGB-D1
        - /Imagenes1
      Splitter Ratio: 0.58
    Tree Height: 720
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: /camera/color/image_raw
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Enabled: true
      Name: Escena
      Displays:
        - Alpha: 0.55
          Cell Size: 0.5
          Class: rviz/Grid
          Color: 160; 160; 164
          Enabled: true
          Line Style:
            Line Width: 0.03
            Value: Lines
          Name: Suelo (world)
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 40
          Reference Frame: world
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Length: 0.75
          Name: Ejes world
          Radius: 0.04
          Reference Frame: world
          Value: true
        - Class: rviz/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: TF
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Update Interval: 0
          Value: true
    - Class: rviz/Group
      Enabled: true
      Name: RGB-D
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Nube de puntos
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.02
          Style: Flat Squares
          Topic: /camera/depth/points
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Length: 0.35
          Name: Ejes camera_link
          Radius: 0.02
          Reference Frame: camera_link
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Length: 0.25
          Name: Ejes optical
          Radius: 0.015
          Reference Frame: camera_depth_optical_frame
          Value: true
    - Class: rviz/Group
      Enabled: true
      Name: Imagenes
      Displays:
        - Class: rviz/Image
          Enabled: true
          Image Topic: /camera/color/image_raw
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: RGB
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
        - Class: rviz/Image
          Enabled: true
          Image Topic: /camera/depth/image_raw
          Max Value: 5
          Median window: 5
          Min Value: 0
          Name: Profundidad
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 38
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 2.8
        Y: 0.0
        Z: 0.9
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: world
      Value: Orbit (rviz)
      Yaw: 0.2
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: false
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 1680
  X: 60
  Y: 40
