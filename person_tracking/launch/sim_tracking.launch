<launch>
  <arg name="gui" default="true" />
  <arg name="rviz" default="true" />
  <arg name="rviz_config" default="$(find person_tracking)/config/person_tracking.rviz" />

  <include file="$(find rgbd_sim)/launch/sim.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="false" />
  </include>

  <include file="$(find person_tracking)/launch/tracking.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="rviz_config" value="$(arg rviz_config)" />
    <arg name="tracking_frame" value="world" />
    <arg name="cloud_topic" value="/camera/depth/points" />
  </include>
</launch>
