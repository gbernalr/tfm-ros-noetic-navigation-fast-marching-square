<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="zed_camera">
    <!-- El modelo lo actualiza gazebo_model_tf_follower.py para que quede
         solidario al TurtleBot. Sin gravedad no cae entre actualizaciones. -->
    <static>false</static>
    <link name="zed_camera_link">
      <gravity>false</gravity>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="body">
        <geometry><box><size>0.18 0.04 0.05</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="left_lens">
        <pose>0.0 -0.06 0 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.05 0.15 0.3 1</ambient><diffuse>0.05 0.15 0.3 1</diffuse></material>
      </visual>
      <visual name="right_lens">
        <pose>0.0 0.06 0 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.05 0.15 0.3 1</ambient><diffuse>0.05 0.15 0.3 1</diffuse></material>
      </visual>
      <sensor name="zed_sim_depth" type="depth">
        <always_on>1</always_on><update_rate>15</update_rate><visualize>true</visualize>
        <camera>
          <horizontal_fov>1.919862</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>12.0</far></clip>
        </camera>
        <plugin name="zed_sim_camera_plugin" filename="libgazebo_ros_openni_kinect.so">
          <baseline>0.12</baseline><alwaysOn>true</alwaysOn><updateRate>0.0</updateRate>
          <cameraName>zed_sim</cameraName><frameName>zed_sim_camera_optical_frame</frameName>
          <imageTopicName>/zed_sim/rgb/image_rect_color</imageTopicName>
          <cameraInfoTopicName>/zed_sim/rgb/camera_info</cameraInfoTopicName>
          <depthImageTopicName>/zed_sim/depth/depth_registered</depthImageTopicName>
          <depthImageCameraInfoTopicName>/zed_sim/depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>/zed_sim/point_cloud/cloud_registered</pointCloudTopicName>
          <pointCloudCutoff>0.3</pointCloudCutoff><pointCloudCutoffMax>12.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
